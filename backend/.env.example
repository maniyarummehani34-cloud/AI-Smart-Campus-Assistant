# Server Configuration
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (no trailing slash)
# Example production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# MySQL Database (Local XAMPP or Hosted Cloud MySQL like Aiven)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_if_set
DB_NAME=campus_assistant_db_v2

# Cloud MySQL SSL/TLS (Set DB_SSL=true for Aiven or other managed MySQL hosts)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional: CA certificate path or single-line PEM string with \n escapes
# DB_SSL_CA=

# Authentication (JWT) — Generate a strong 64+ character random secret for production
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=1d

# Optional: Configurable grading rules JSON override
# GRADING_RULES_JSON=

# Optional: One-time Admin creation via `npm run create-admin`
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Optional: Required only when running `npm run seed-large` locally
# Supply your own local prefixes; never commit real passwords
# DEMO_TEACHER_PASS_PREFIX=
# DEMO_STUDENT_PASS_PREFIX=

# Google Gemini API (Keep strictly on the backend!)
# GEMINI_API_KEY=your_gemini_api_key
