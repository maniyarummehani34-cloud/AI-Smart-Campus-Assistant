# Server Configuration
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (no trailing slash)
# Local dev only: http://localhost:5173
# Local dev + Vercel: http://localhost:5173,https://your-app.vercel.app
# Production Vercel only: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Optional API rate-limiting overrides (requests per 15-minute window per IP)
# API_RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=25

# PostgreSQL Database (Primary — Local PostgreSQL or Hosted Cloud PostgreSQL)
# Option 1: Single connection URL (recommended for hosted cloud PostgreSQL)
# DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/campus_assistant_pg
# Option 2: Individual PostgreSQL variables
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_postgres_password
PG_DATABASE=campus_assistant_pg

# PostgreSQL SSL/TLS (Set PG_SSL=true for hosted cloud PostgreSQL)
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true
# Optional: CA certificate path or single-line PEM string with \n escapes
# PG_SSL_CA=

# Legacy MySQL Database Fallback (Local XAMPP or Hosted Cloud MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_if_set
DB_NAME=campus_assistant_db_v2

# Cloud MySQL SSL/TLS (Set DB_SSL=true for Aiven or other managed MySQL hosts)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional: CA certificate path or single-line PEM string with \n escapes
# DB_SSL_CA=

# Authentication (JWT) — Generate a strong 64+ character random secret for production
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=1d

# Optional: Configurable grading rules JSON override
# GRADING_RULES_JSON=

# Optional: One-time Admin creation via `npm run create-admin`
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Optional: Required only when running `npm run seed-large` locally
# Supply your own local prefixes; never commit real passwords
# DEMO_TEACHER_PASS_PREFIX=
# DEMO_STUDENT_PASS_PREFIX=

# Google Gemini API (Keep strictly on the backend!)
# GEMINI_API_KEY=your_gemini_api_key
